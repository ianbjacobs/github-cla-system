{
  "name": "github-cla-actions",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Actions-only GitHub contributor agreement workflow.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run test",
    "validate:issue": "node scripts/validate-signing-issue.mjs",
    "check:agreement": "node scripts/check-contributor-agreement.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "vitest": "^3.2.0"
  },
  "license": "W3C"
}
