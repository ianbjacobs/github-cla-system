{
  "name": "github-cla-actions",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Serverless GitHub Actions workflow for collecting and enforcing contributor agreements.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run test",
    "validate:issue": "node scripts/validate-signing-issue.mjs",
    "check:agreement": "node scripts/check-contributor-agreement.mjs",
    "prepare:agreement-pr": "node scripts/prepare-agreement-pr.mjs",
    "evaluate:agreement": "node scripts/evaluate-contributor-agreement.mjs",
    "refresh:agreements": "node scripts/refresh-contributor-agreements.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "vitest": "^3.2.0"
  },
  "license": "W3C"
}
