{
  "name": "github-cla-system",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Experimental GitHub-native contributor agreement workflow implemented as a framework-independent GitHub App.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "biome check --write . && tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.1.1",
    "@octokit/rest": "^22.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "license": "W3C"
}
